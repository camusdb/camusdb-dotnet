<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>CamusDB.Dapper</PackageId>
    <Version>0.14.0</Version>
    <Description>Dapper support for CamusDB: typed parameters, native array parameters and type handlers.</Description>
    <Authors>CamusDB</Authors>
    <Company>CamusDB</Company>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageDescription>CamusDB.Dapper adds CamusDB-specific parameter types and type handlers to Dapper.</PackageDescription>
    <PackageProjectUrl>https://github.com/camusdb/camusdb-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/camusdb/camusdb-dotnet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dotnet;camusdb;dapper;micro-orm</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CamusDB.Client\CamusDB.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
